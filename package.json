{
  "name": "wc-basic-slider",
  "version": "0.0.1",
  "main": "index.js",
  "repository": "https://github.com/mamunur105/wc-basic-slider.git",
  "author": "Mamunur Rashid <30565480+mamunur105@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production && npm run cleanmap",
    "production": "mix --production",
    "package": "npm run clean && npm run dev && npm run prod && cross-env npm_config_package=true npm run dev",
    "clean": "rm -rf dist/*",
    "cleanmap": "rm -rf assets/**/**/*.map",
    "zip": "npm run package && cross-env npm_config_zip=true npm run dev "
  },
  "devDependencies": {
    "@babel/preset-react": "^7.18.6",
    "archiver": "^5.3.1",
    "cli-color": "^2.0.3",
    "cross-env": "^10.1.0",
    "emojic": "^1.1.17",
    "fs-extra": "^10.1.0",
    "laravel-mix": "^6.0.49",
    "postcss": "^8.3.1",
    "sass": "^1.54.0",
    "sass-loader": "^12.1.0",
    "wp-pot": "^1.10.2"
  }
}
